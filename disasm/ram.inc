; ram.inc — RAM and register equates for the Blaster Master disassembly.
; GENERATED by tools/Disassembler (RamIncludeWriter) from the `space: ram` labels in
; disasm/<variant>/input/hints.yaml — do not hand-edit; edit hints.yaml and re-run.
;
; Public tree: only labels with `status: verified` appear here. An address whose meaning is
; not yet signed off stays a bare number in the listings rather than shipping a name the
; project has not stood behind — see docs/meta/verification-workflow.md.
;
; Prose lives in hints.yaml and docs/wip/ram-map.md; the one-liners below are a legend.

; Global counter incremented every frame.  Does not increment on lag frames.
Global_FrameCounter               := $0011
; Half-WIDTH of the active object's terrain-collision box, measured from the object's centre,
; in the same 4.4 fixed-pixel units as LoadedObj_Position_X_Lo (so $80 = 8.0 px = a 16 px wide
; box, $40 = 8 px wide, $C0 = 24 px wide). Set by the object's handler on entry, every frame.
; Together with LoadedObj_CollisionBox_HalfHeight it defines one axis-aligned box centred on
; the object. Both bytes are read ONLY by H_Collision_Check ($D37D) and V_Collision_Check
; ($D3E1). So this is strictly terrain/tile collision.
; Full write-up: docs/misc/terrain-collision.md
LoadedObj_CollisionBox_HalfWidth  := $0042
; Half-HEIGHT of the active object's terrain-collision box, measured from the object's centre,
; in the same 4.4 fixed-pixel units as LoadedObj_Position_Y_Lo (so $80 = 8.0 px = a 16 px tall
; box, $40 = 8 px tall, $C0 = 24 px tall). Set by the object's handler on entry, every frame.
; Full write-up: docs/misc/terrain-collision.md
LoadedObj_CollisionBox_HalfHeight := $0043
; Obj: The 14-byte record every active object occupies. 18 are packed at $0400 (the object
; table); slot 0 is the player.
.struct Obj
        Type          .byte   ; +$00 (byte)  Entity type / ObjType. 0 = empty (inactive slot); 1 = reserved; 2 = tombstoned; any other value dispatches to an AI handler.
        Facing        .byte   ; +$01 (byte)  Direction byte (ObjType-defined: 8-bit heading angle / 2-bit direction index / facing bit-flags).
        Position_X_Lo .byte   ; +$02 (fixed44)  The lower 8-bits of the Signed 16-bit Fixed Point position (swww wwww WWWW.FFFF) representing the object's X-position.
        Position_X_Hi .byte   ; +$03 (sbyte)  The upper 8-bits of the Signed 16-bit Fixed Point position (SWWW WWWW wwww.ffff) representing the object's X-position.
        Position_Y_Lo .byte   ; +$04 (fixed44)  The lower 8-bits of the Signed 16-bit Fixed Point position (swww wwww WWWW.FFFF) representing the object's Y-position.
        Position_Y_Hi .byte   ; +$05 (sbyte)  The upper 8-bits of the Signed 16-bit Fixed Point position (SWWW WWWW wwww.ffff) representing the object's Y-position.
        Velocity_X    .byte   ; +$06 (sfixed44)  X velocity in px/frame (signed 4.4: swww.ffff).
        Velocity_Y    .byte   ; +$07 (sfixed44)  Y velocity in px/frame (signed 4.4: swww.ffff).
        TileIndex     .byte   ; +$08 (byte)  Index of the tile this object currently occupies in the loaded tile-flag window LevelTileData ($0500). Used for collision, not rendering.
        .res          1       ; +$09
        Scratch0      .byte   ; +$0A (byte)  General-purpose per-handler byte (offset +10); meaning is entirely ObjType-defined.
        Scratch1      .byte   ; +$0B (byte)  General-purpose per-handler byte (offset +11); meaning is entirely ObjType-defined.
        Scratch2      .byte   ; +$0C (byte)  General-purpose per-handler byte (offset +12); meaning is entirely ObjType-defined.
        Health        .byte   ; +$0D (byte)  HP for this entity.
.endstruct
; Contact: The 3-byte record in the contact table at $7C-$8D -- the hit-exchange channel
; between the player's side and the enemies. Six records, one per object slot 0-5 (slot 0 =
; the player, 1-5 = his shots/sub-weapons; the allocators keep enemies out of this range --
; Obj_SpawnChild $D852 searches slots 6-17, Obj_TryCloneLoadedObjectIntoEmptySlot $DF13
; searches 8-15). Enemies never occupy a record, they only scan it.
.struct Contact
        .res 3       ; +$00..+$02
.endstruct
; OamEntry: One hardware sprite as the NES OAM lays it out: 4 bytes, Y / tile / attribute / X.
; This is the PPU's own record format, not a game-defined one -- SpriteStagingBuf ($0600) is
; an array of these, and OAM_BlitFromStaging ($EC73) copies whole records straight into the
; $0200 OAM shadow, which the NMI DMAs to $2004 via $4014.
.struct OamEntry
        Screen_Y .byte   ; +$00 (byte)  Screen Y minus 1 (the PPU renders a sprite on the scanline AFTER this value). $EF..$FF puts the sprite off-screen, which is how OAM_HideAll ($EC61) hides one.
        Tile     .byte   ; +$01 (byte)  Pattern-table tile index. In 8x16 sprite mode bit 0 selects the pattern table ($0000/$1000) and bits 7-1 are the tile pair, which is why the overhead section's CHR banks are assigned in even/odd pairs.
        Attr     .byte   ; +$02 (byte)  Attribute byte: bits 0-1 sprite palette, bit 5 priority (behind background), bit 6 horizontal flip, bit 7 vertical flip. Built by the metasprite renderer as ($44 & $C3) EOR ctrl, so the def's per-tile ctrl bits contribute the flips and the palette EOR.
        Screen_X .byte   ; +$03 (byte)  Screen X, left edge.
.endstruct
; The 14-byte zero-page working copy of the currently active object slot
LoadedObject := $0046   ; Obj[] base — indexed access (any element)
LoadedObj    := $0046   ; element 0 — direct access
; The contact table: 6 Contact records (3 bytes each) packed at $7C-$8D, one per object slot
; 0-5 -- slot 0 is the player, 1-5 are his shots/sub-weapons. NOT three separate tables: the
; three columns are interleaved, so indexed access (X = ObjectSlot_Index $57 x 3, via
; SlotIndexX3 $D798) walks records while the field offset picks the column. That is why the
; old flat labels SpriteX_Table/SpriteY_Table/SpriteAttr_Table at $7C/$7D/$7E each named a
; single byte -- record 0's own three fields -- while reading as though they were arrays; and
; why their "18 entries" description was wrong twice over (18 is the BYTE count; there are 6
; records). The record count is pinned three independent ways: Collision_Detection_Sub scans
; ldx #$0F then dex x3 ($D6E7) = records 5 down to 0; SpriteX_ClearAll ($D7B6) zeroes exactly
; $7C-$8D at AreaInit; and $8E is an unrelated variable. Direct (unindexed) access is record
; 0, the player -- see PlayerContact, and HitboxTest_LockOn ($D71F), which is the "did this
; enemy attack hit the player?" test and reads $7C/$7D/$7E with no index at all.
ContactTable  := $007C   ; Contact[] base — indexed access (any element)
PlayerContact := $007C   ; element 0 — direct access
Projectile1   := $007F   ; element 1
Projectile2   := $0082   ; element 2
Projectile3   := $0085   ; element 3
Projectile4   := $0088   ; element 4
Projectile5   := $008B   ; element 5
; The object table: 18 Obj records (14 bytes each) packed at $0400-$04FB. Slot 0 is reserved
; for the player (Sophia/Jason); slots 1-17 hold enemies, projectiles, pickups, gates and
; other objects. Indexed access ($0400,X with X = ObjectSlot_Offset $56) reaches any slot;
; direct access is slot 0 (PlayerSlot). Before each AI dispatch ObjSlot_Load copies the active
; slot to ZP $46-$53; ObjSlot_Save writes it back.
ObjectTable    := $0400   ; Obj[] base — indexed access (any element)
PlayerSlot     := $0400   ; element 0 — direct access
Object_Slot_01 := $040E   ; element 1
Object_Slot_02 := $041C   ; element 2
Object_Slot_03 := $042A   ; element 3
Object_Slot_04 := $0438   ; element 4
Object_Slot_05 := $0446   ; element 5
Object_Slot_06 := $0454   ; element 6
Object_Slot_07 := $0462   ; element 7
Object_Slot_08 := $0470   ; element 8
Object_Slot_09 := $047E   ; element 9
Object_Slot_10 := $048C   ; element 10
Object_Slot_11 := $049A   ; element 11
Object_Slot_12 := $04A8   ; element 12
Object_Slot_13 := $04B6   ; element 13
Object_Slot_14 := $04C4   ; element 14
Object_Slot_15 := $04D2   ; element 15
Object_Slot_16 := $04E0   ; element 16
Object_Slot_17 := $04EE   ; element 17
; The sprite staging buffer: 20 OamEntry records the renderers append to, then blitted
; wholesale into the $0200 OAM shadow by OAM_BlitFromStaging ($EC73) and DMAd to the PPU from
; there. The write head is a BYTE offset in OAM_Staging_Entry_Length ($3C), so every access is
; $0600,X with X a multiple of 4 -- the stagers index the array, they do not address a slot by
; name. Extent: MetaSprite_RenderNoBank ($F04F) flushes the buffer whenever $3C reaches $40,
; BEFORE staging each entry, and the largest single stager adds $10 bytes (4 sprites,
; $EE77/$EEE9) at offsets +$00..+$0F. $40 + $10 = $50 = 80 bytes = exactly 20 records, which
; lands the buffer at $0600-$064F and stops one byte short of Palette_Shadow ($0650) -- the
; threshold looks chosen so the largest entry cannot overrun the palette. Appended by
; Sprite_Stage ($ECB4, 1 sprite) and the shape stagers $ECD1/$ED12/$ED54/$EDA4/$EDF5/
; $EE77/$EEE9 (2-4 sprites each), all of which write $0600+N,X for N = 0..$0F and then advance
; $3C by their own byte count.
SpriteStagingBuf         := $0600   ; OamEntry[] base — indexed access (any element)
SpriteStagingBuf_Sprite0 := $0600   ; element 0 — direct access
SpriteStagingBuf_Sprite1 := $0604   ; element 1
SpriteStagingBuf_Sprite2 := $0608   ; element 2
SpriteStagingBuf_Sprite3 := $060C   ; element 3

; Byte offset of the active slot
ObjectSlot_Offset                 := $0056
; Index of the active slot
ObjectSlot_Index                  := $0057
; Counter for Sophia's "look up" animation.
; 0x00 is not started
; 0x0C is completed (looking straight up)
Sophia_LookUpAnimation_Counter    := $0094
; Set by Obj_MoveAndCollide and Obj_MoveAndCollide_Double.
; bit 7 set means a collision happened to the left or right.
; bit 6 set means a collision happened above or below.
; The value of LoadedObj's velocity is used to disambiguate the collision side.
TerrainCollisionFlags             := $009A
; 18-entry array (one per object slot, indexed by ObjectSlot_Index) used to stash an object's
; real ObjType when it is made Dormant (ObjType $02).
; The Dormant ObjType handler then reads from this table to restore the tombstoned Object.
DormantSlot_SavedType             := $0150
